# ── Site ─────────────────────────────────────────────
# Canonical origin, no trailing slash. Used by SEO layer, sitemap, canonical URLs.
VITE_SITE_URL=https://wowstack.com
VITE_SITE_NAME=Wowstack

# ── Supabase (public / anon — safe to expose) ────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Analytics (optional) ─────────────────────────────
VITE_GA_ID=
VITE_PLAUSIBLE_DOMAIN=

# NOTE: Never put a service_role key or any secret here.
# Anything sensitive belongs in a Supabase Edge Function (backend/).
